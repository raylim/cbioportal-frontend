<clickhouse>
    <!-- Same limits as the upstream cbioportal-docker-compose ClickHouse setup: study-wide
         requests inline every sample id, which can exceed the default 256 KB max_query_size. -->
    <profiles>
        <client_user_profile>
            <max_query_size>1000000000</max_query_size>
            <max_ast_elements>6000000</max_ast_elements>
            <max_expanded_ast_elements>6000000</max_expanded_ast_elements>
        </client_user_profile>
    </profiles>
    <users>
        <cbio>
            <profile>client_user_profile</profile>
        </cbio>
    </users>
</clickhouse>
