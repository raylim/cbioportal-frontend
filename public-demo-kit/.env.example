# Copy to .env (setup.sh does this and fills in the secrets).

# ---- pinned sources (public GitHub commits; images are built from these) ----
# raylim/cbioportal, branch codex/wsi-rd-annotation-capability
PORTAL_SHA=edda2b8b856d8d6bb1f36d775607b86be98b6ef1
# raylim/cbioportal-frontend, branch codex/wsi-rd-agent
FRONTEND_SHA=85c4a7e8cd16a33c6ded9b6caefebe16329a2a2a
# cBioPortal/cbioportal-tile-server, branch codex/wsi-research-agent-child
TILE_SHA=238433e8767119df63150be2152b0755b1acfaf7
# cBioPortal/cbioportal-core (importer), branch main
CORE_SHA=6146cdbf916e30ba8d0a9a5cced224d715af28d5

# ---- where the demo is reached ----
# The browser must use exactly this origin (the portal and tile server are configured for it).
PUBLIC_ORIGIN=http://localhost:27800
WEB_PORT=27800
CLICKHOUSE_HTTP_PORT=27801
# 127.0.0.1 = this machine only. Use 0.0.0.0 to expose on the network (then set PUBLIC_ORIGIN
# to http://<your-host>:27800).
BIND_ADDRESS=127.0.0.1

# ---- data ----
# Downloads (study tarball ~0.5 GB, slides ~0.2 GB each) and generated study files.
DATA_DIR=./data
# Number of TCGA-BRCA diagnostic slides to download (each from a different patient).
SLIDE_COUNT=6

# ---- secrets (setup.sh generates these with openssl; never commit .env) ----
CLICKHOUSE_PASSWORD=
ANNOTATION_PG_PASSWORD=
# HS256 secret shared by the portal (wsi.access-token-secret) and the tile server.
WSI_AUTH_SECRET=
# base64 of 32 random bytes; seals each slide's file path into its resource row.
WSI_SOURCE_SEAL_KEY=

# ---- slide assistant (optional) ----
# setup.sh turns this on when secrets/openai_api_key exists (one line, an sk-... key).
WSI_AGENT_ENABLED=false
WSI_AGENT_MODEL=gpt-4.1-mini
OPENAI_API_KEY_FILE_IN_CONTAINER=
SECRETS_DIR=./secrets

# ---- tuning ----
TILE_WORKERS=1
PORTAL_JAVA_OPTS="-Xms512m -Xmx3g -XX:+UseG1GC"
